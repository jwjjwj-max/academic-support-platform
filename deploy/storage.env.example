# Copy to a private server-side configuration file; never commit real keys.
# Fill in the API credentials of the dedicated storage sub-user.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-appid
COS_REGION=ap-shanghai

# Keep false until CORS and browser Blob preview pass for the final origin.
STORAGE_DIRECT_READ=false
STORAGE_DIRECT_UPLOAD=false
